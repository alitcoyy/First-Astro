---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site';
---

<Layout title="Home">
  <section class="hero">
    <h1>Websites that load fast and <span class="gradient-text">get results.</span></h1>
    <p class="lead">{SITE.name} is a small studio that designs and builds lean, modern websites for growing businesses.</p>
    <a href="/contact" class="btn">Start a project</a>
  </section>

  <section>
    <h2>What we do</h2>
    <div class="grid">
      <div class="card">
        <h3>Design</h3>
        <p>Clean, focused layouts that make your message clear on every screen.</p>
      </div>
      <div class="card">
        <h3>Build</h3>
        <p>Fast static sites with no unnecessary code, so pages load in a blink.</p>
      </div>
      <div class="card">
        <h3>Launch</h3>
        <p>Automatic deploys and simple updates, so your site keeps moving with you.</p>
      </div>
    </div>
  </section>

  <section class="cta card">
    <h2>Ready to get started?</h2>
    <p>Tell us about your project and we'll get back to you within one business day.</p>
    <a href="/contact" class="btn">Get in touch</a>
  </section>
</Layout>

<style lang="scss">
  section + section { margin-top: 4rem; }
  .hero { padding-block: 2rem; }

  .cta {
    text-align: center;

    p { color: var(--muted); }
  }
</style>
