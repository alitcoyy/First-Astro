---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | {SITE.name}</title>
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global lang="scss">
  // Theme colours live in CSS custom properties so dark mode can swap them at runtime.
  $font-stack: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  $container-max: 64rem;
  $measure: 40rem;

  :root {
    --fg: #1a1a1a;
    --muted: #5c5c5c;
    --bg: #fff;
    --surface: #f5f5f4;
    --border: #e2e2e0;
    --accent: #2563eb;
    --accent-2: #db2777;
    --accent-fg: #fff;
    --gradient: linear-gradient(135deg, var(--accent), var(--accent-2));
    --radius: 8px;
    color-scheme: light dark;

    @media (prefers-color-scheme: dark) {
      --fg: #ececec;
      --muted: #a3a3a3;
      --bg: #141414;
      --surface: #1f1f1f;
      --border: #2e2e2e;
      --accent: #60a5fa;
      --accent-2: #f472b6;
      --accent-fg: #0d0d0d;
    }
  }

  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font: 1rem/1.6 $font-stack;
    color: var(--fg);
    background: var(--bg);
  }

  main { flex: 1; padding-block: 3rem; }
  .container { width: min(100% - 2rem, $container-max); margin-inline: auto; }
  h1, h2, h3 { line-height: 1.2; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin-top: 0; }
  a { color: var(--accent); }
  .lead { font-size: 1.2rem; color: var(--muted); max-width: $measure; }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--gradient);
    color: var(--accent-fg);
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;

    &:hover { opacity: 0.9; }
  }

  .grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }

  .card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);

    h3 { margin-top: 0; }
  }

  .gradient-text { background: var(--gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
</style>
