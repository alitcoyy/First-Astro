---
// Soft, slowly drifting gradient blobs behind a hero. Place inside a `.hero`.
---

<div class="glow" aria-hidden="true"><span></span><span></span><span></span></div>

<style lang="scss">
  .glow {
    position: absolute;
    inset: -4rem 0 auto auto;
    z-index: -1;
    width: min(32rem, 80%);
    aspect-ratio: 1;
    filter: blur(60px);
    opacity: 0.35;
    pointer-events: none;

    span { position: absolute; border-radius: 50%; animation: float 14s ease-in-out infinite; }
    span:nth-child(1) { inset: 10% 30% 30% 10%; background: var(--accent); }
    span:nth-child(2) { inset: 30% 5% 10% 35%; background: var(--accent-2); animation-delay: -5s; }
    span:nth-child(3) { inset: 0 10% 50% 45%; background: #8b5cf6; animation-delay: -9s; }
  }

  @keyframes float {
    0%, 100% { translate: 0 0; scale: 1; }
    33% { translate: 8% -6%; scale: 1.1; }
    66% { translate: -6% 8%; scale: 0.95; }
  }

  @media (prefers-reduced-motion: reduce) { span { animation: none; } }
</style>
