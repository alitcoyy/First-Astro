---
import { Image } from 'astro:assets';
import { SITE, NAV } from '../site';
import logo from '../assets/sdb-logo-white.webp';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
  <div class="container bar">
    <a href="/" class="brand">
      <Image src={logo} alt={SITE.name} loading="eager" />
    </a>
    <nav aria-label="Main">
      {NAV.map(({ href, label }) => (
        <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>

<style lang="scss">
  header { border-bottom: 1px solid var(--border); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem; padding-block: 1rem; }
  .brand {
    display: flex;

    img {
      height: 28px;
      width: auto;
      // The logo is white: darken it on the light theme, keep it white on dark.
      filter: brightness(0);

      @media (prefers-color-scheme: dark) { filter: none; }
    }
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;

    a {
      color: var(--muted);
      text-decoration: none;

      &:hover, &[aria-current='page'] { color: var(--fg); }

      &[aria-current='page'] {
        font-weight: 600;
        text-decoration: underline;
        text-decoration-color: var(--accent-2);
        text-decoration-thickness: 2px;
        text-underline-offset: 6px;
      }
    }
  }
</style>
