---
// Endlessly scrolling strip of words. The list is rendered twice for a seamless loop;
// the copy is hidden from screen readers. With reduced motion it becomes a static, wrapped list.
interface Props { items: string[]; label?: string }
const { items, label } = Astro.props;
---

<div class="ticker">
  <ul class="track" aria-label={label}>
    {items.map((t) => <li>{t}</li>)}
    {items.map((t) => <li aria-hidden="true">{t}</li>)}
  </ul>
</div>

<style lang="scss">
  .ticker {
    overflow: hidden;
    border-block: 1px solid var(--border);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: marquee 35s linear infinite;

    &:hover { animation-play-state: paused; }

    li { padding: 0.9rem 1.5rem; font-weight: 600; color: var(--muted); white-space: nowrap; }
    li::before { content: '✦'; margin-right: 1.5rem; color: var(--accent-2); }
  }

  @keyframes marquee { to { translate: -50% 0; } }

  @media (prefers-reduced-motion: reduce) {
    .ticker { mask-image: none; }
    .track { width: auto; flex-wrap: wrap; animation: none; }
    [aria-hidden] { display: none; }
  }
</style>
