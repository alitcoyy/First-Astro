---
import { SITE, NAV } from '../site';

const year = new Date().getFullYear();
---

<footer>
  <div class="container cols">
    <div>
      <strong>{SITE.name}</strong>
      <p>{SITE.description}</p>
    </div>
    <nav aria-label="Footer">
      {NAV.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>
    <div>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <p>{SITE.phone}</p>
    </div>
  </div>
  <p class="container copy">&copy; {year} {SITE.name}. All rights reserved.</p>
</footer>

<style>
  footer { border-top: 1px solid var(--border); background: var(--surface); color: var(--muted); font-size: 0.95rem; }
  .cols { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); padding-block: 2rem 1rem; }
  strong { color: var(--fg); }
  p { margin: 0.25rem 0 0; }
  nav { display: flex; flex-direction: column; gap: 0.25rem; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover { color: var(--fg); }
  .copy { padding-block: 0 1.5rem; font-size: 0.85rem; }
</style>
