---
import { SITE, NAV, SOCIAL } from '../site';

const year = new Date().getFullYear();
---

<footer>
  <div class="container cols">
    <div>
      <strong>{SITE.name}</strong>
      <p>{SITE.description}</p>
    </div>
    <nav aria-label="Footer">
      {NAV.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>
    <div>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <p>{SITE.address}</p>
      <p class="social">
        {SOCIAL.map(({ href, label }) => <a href={href} rel="noopener">{label}</a>)}
      </p>
    </div>
  </div>
  <p class="container copy">&copy; {year} {SITE.legalName} All rights reserved.</p>
</footer>

<style lang="scss">
  footer { border-top: 1px solid var(--border); background: var(--surface); color: var(--muted); font-size: 0.95rem; }
  .cols { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); padding-block: 2rem 1rem; }
  strong { color: var(--fg); }
  p { margin: 0.25rem 0 0; }

  nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  nav a, .social a {
    color: var(--muted);
    text-decoration: none;

    &:hover { color: var(--fg); }
  }

  .social { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; margin-top: 0.75rem; }
  .copy { margin-inline: auto; padding-block: 0 1.5rem; font-size: 0.85rem; }
</style>
